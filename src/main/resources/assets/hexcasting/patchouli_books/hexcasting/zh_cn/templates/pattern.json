{
  "processor": "at.petrak.hexcasting.interop.patchouli.PatternProcessor",
  "components": [
    {
      "type": "header",
      "text": "#translation_key",
      "x": -1,
      "y": -1
    },
    {
      "type": "separator",
      "x": -1,
      "y": -1
    },
    {
      "type": "custom",
      "class": "at.petrak.hexcasting.interop.patchouli.LookupPatternComponent",
      "x": 58,
      "y": 50,
      "op_id": "#op_id",
      "hex_size": "#hex_size"
    },
    {
      "type": "text",
      "text": "$(n)#input#/$ → $(n)#output#/$",
      "guard": "#has_signature#",
      "y": 80
    },
    {
      "type": "text",
      "text": "#text#",
      "guard": "#has_signature->inv#",
      "y": 80
    },
    {
      "type": "text",
      "text": "#text#",
      "guard": "#has_signature#",
      "y": 89
    }
  ]
}
